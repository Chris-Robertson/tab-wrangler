{
  "manifest_version": 3,
  "name": "Tab Wrangler",
  "version": "1.0.0",
  "description": "Intelligently manage, group, and clean up browser tabs with rule-based automation",
  
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage",
    "alarms"
  ],
  
  "background": {
    "service_worker": "background/index.ts",
    "type": "module"
  },
  
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Tab Wrangler"
  },
  
  "options_page": "options/index.html",
  
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}

